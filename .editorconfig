root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4
tab_width = 4

# YAML forbids tabs.
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Dart keeps dart format's two-space indentation (canon 006).
[*.dart]
indent_style = space
indent_size = 2

# Two trailing spaces are a hard line break in Markdown.
[*.md]
trim_trailing_whitespace = false
